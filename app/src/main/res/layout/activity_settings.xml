<?xml version="1.0" encoding="utf-8"?>
<!-- Системные отступы — на обёртке: fitsSystemWindows заменяет padding самого элемента. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    style="@style/Screen"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="top">

    <TextView
        style="@style/Title"
        android:layout_marginTop="16dp"
        android:text="@string/settings_music_title" />

    <TextView
        style="@style/Body"
        android:layout_marginTop="12dp"
        android:text="@string/settings_music_hint"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/musicName"
        style="@style/Body"
        android:layout_marginTop="32dp"
        android:background="@color/surface"
        android:padding="16dp"
        android:textColor="@color/text_primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pick"
        style="@style/MainButton"
        android:layout_marginTop="24dp"
        android:text="@string/settings_pick" />

    <TextView
        style="@style/Title"
        android:layout_marginTop="40dp"
        android:text="@string/settings_rules_title" />

    <!-- Под каждым вариантом — его особенности, с отступом под текст варианта. -->
    <RadioGroup
        android:id="@+id/rules"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <RadioButton
            android:id="@+id/rulesFsm"
            style="@style/Option"
            android:text="@string/settings_rules_fsm" />

        <TextView
            style="@style/Body"
            android:layout_marginStart="32dp"
            android:gravity="start"
            android:text="@string/settings_rules_fsm_hint"
            android:textSize="15sp" />

        <RadioButton
            android:id="@+id/rulesMsl"
            style="@style/Option"
            android:layout_marginTop="8dp"
            android:text="@string/settings_rules_msl" />

        <TextView
            style="@style/Body"
            android:layout_marginStart="32dp"
            android:gravity="start"
            android:text="@string/settings_rules_msl_hint"
            android:textSize="15sp" />
    </RadioGroup>

    <TextView
        style="@style/Title"
        android:layout_marginTop="40dp"
        android:text="@string/settings_deal_title" />

    <CheckBox
        android:id="@+id/autoDeal"
        style="@style/Option"
        android:layout_marginTop="12dp"
        android:text="@string/settings_auto_deal" />

    <TextView
        style="@style/Title"
        android:layout_marginTop="40dp"
        android:text="@string/settings_duck_title" />

    <TextView
        style="@style/Body"
        android:layout_marginTop="12dp"
        android:text="@string/settings_duck_hint"
        android:textSize="15sp" />

    <!-- Варианты столбиком: в ряд не помещаются при крупном шрифте. -->
    <RadioGroup
        android:id="@+id/duck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <RadioButton
            android:id="@+id/duck20"
            style="@style/Option"
            android:text="@string/settings_duck_20" />

        <RadioButton
            android:id="@+id/duck50"
            style="@style/Option"
            android:text="@string/settings_duck_50" />

        <RadioButton
            android:id="@+id/duck80"
            style="@style/Option"
            android:text="@string/settings_duck_80" />
    </RadioGroup>

    <TextView
        style="@style/Title"
        android:layout_marginTop="40dp"
        android:text="@string/settings_night_title" />

    <TextView
        style="@style/Body"
        android:layout_marginTop="12dp"
        android:text="@string/settings_night_hint"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nightLess"
            style="@style/SecondaryButton"
            android:text="@string/settings_less" />

        <TextView
            android:id="@+id/nightTurn"
            style="@style/Title"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nightMore"
            style="@style/SecondaryButton"
            android:text="@string/settings_more" />
    </LinearLayout>
</LinearLayout>
</ScrollView>
</FrameLayout>